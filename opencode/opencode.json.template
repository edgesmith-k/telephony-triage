{
  "$schema": "https://opencode.ai/config.json",
  "model": "gw/@@MODEL_ID@@",
  "small_model": "gw/@@MODEL_ID@@",
  "default_agent": "triage",
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,
  "instructions": [],
  "provider": {
    "gw": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "internal gateway",
      "options": {
        "baseURL": "@@GATEWAY_BASE_URL@@",
        "apiKey": "{env:TT_GATEWAY_API_KEY}"
      },
      "models": {
        "@@MODEL_ID@@": {
          "name": "@@MODEL_ID@@",
          "limit": {
            "context": 202000,
            "output": 16000
          }
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/issue_raw.json": "deny",
      "**/events.json": "deny",
      "**/events-full.json": "deny",
      "**/match.json": "deny",
      "**/jira_raw.json": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "deny",
      "python3 *": "allow",
      "python *": "allow",
      "cd *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "stat *": "allow",
      "diff *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "true": "allow",
      "find *": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git diff*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git push": "deny",
      "git push *": "deny",
      "* git push *": "deny",
      "git*push*": "deny",
      "gh *": "deny",
      "*opencode *": "deny",
      "find *-exec*": "deny",
      "find *-ok*": "deny",
      "find *-delete*": "deny",
      "find *-fprint*": "deny",
      "*db_pr.py publish*": "deny",
      "*db_pr.py merge*": "deny",
      "*db_pr.py request-review*": "deny",
      "*issue_post.py approve*": "deny",
      "*skill_patch.py*--apply*": "deny",
      "*module_eval.py*": "deny"
    },
    "edit": {
      "*": "deny",
      "@@WORK_ROOT_REL@@/**": "allow",
      "@@ISSUE_DB_ROOT_REL@@/**": "deny",
      "@@PLUGIN_ROOT_REL@@/**": "deny",
      "**/.opencode/**": "deny",
      "**/opencode.json": "deny",
      "**/AGENTS.md": "deny",
      "**/tt-oc.json": "deny"
    },
    "external_directory": {
      "*": "deny",
      "@@PLUGIN_ROOT@@/**": "allow",
      "@@WORK_ROOT@@/**": "allow",
      "@@ISSUE_DB_ROOT@@/**": "allow"
    },
    "task": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "codesearch": "deny",
    "question": "deny",
    "jira_*": "deny",
    "github_*": "deny"
  },
  "mcp": {}
}
