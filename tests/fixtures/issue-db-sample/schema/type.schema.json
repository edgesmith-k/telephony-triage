{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "type.md frontmatter (03-issue-db.md §5.4 (1))",
  "description": "이슈 유형 파일의 YAML frontmatter. 허용 값의 원본은 contracts.md §상태 값이다. 카테고리 목록·ID 접두어 일치·related 양방향·evidence 존재·용어집은 JSON Schema가 아니라 db_lint.py가 검사한다 (02-config.md §5.3).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "category", "secondary_categories", "title", "summary", "status", "symptom_signatures", "causes", "tags"],
  "properties": {
    "id": {"$ref": "#/$defs/typeId"},
    "category": {"$ref": "#/$defs/categoryKey"},
    "secondary_categories": {"type": "array", "items": {"$ref": "#/$defs/categoryKey"}, "uniqueItems": true},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "summary": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/typeStatus"},
    "symptom_signatures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/signature"}},
    "causes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cause"}},
    "tags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true}
  },
  "$defs": {
    "typeId": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$"},
    "causeId": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}-[0-9]{2}$"},
    "categoryKey": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "sigId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "isoDate": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "typeStatus": {"type": "string", "pattern": "^(active|deprecated|merged-into:[A-Z][A-Z0-9]*-[0-9]{3})$"},
    "causeStatus": {"type": "string", "pattern": "^(active|deprecated|merged-into:[A-Z][A-Z0-9]*-[0-9]{3}-[0-9]{2})$"},
    "eventName": {
      "description": "extractor 이벤트는 접두어 없음, 백엔드 내장은 builtin.<category>.<이름>, 어댑터는 ext.<category>.<이름> (04-parser-matching.md §5.8 (2))",
      "type": "string",
      "pattern": "^((builtin|ext)\\.[a-z][a-z0-9_]*\\.)?[a-z][a-z0-9_]*$"
    },
    "mustEventItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event"],
      "properties": {
        "id": {"$ref": "#/$defs/sigId"},
        "event": {"$ref": "#/$defs/eventName"},
        "fields": {"type": "object", "additionalProperties": {"type": "string"}, "minProperties": 1}
      }
    },
    "signature": {
      "description": "시그니처 의미는 04-parser-matching.md §5.11 (1). must_match와 must_event 중 하나 이상 필요하다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "window_sec"],
      "anyOf": [{"required": ["must_match"]}, {"required": ["must_event"]}],
      "properties": {
        "id": {"$ref": "#/$defs/sigId"},
        "must_match": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "must_event": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mustEventItem"}},
        "must_not_match": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "window_sec": {"type": "integer", "minimum": 1},
        "same_phone": {"type": "boolean"},
        "sequence": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/sigId"}, "uniqueItems": true}
      }
    },
    "codeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "symbol"],
      "properties": {
        "ref": {
          "description": "<root 키>:<루트 기준 상대 경로>. 절대 경로 금지 (03-issue-db.md §5.7 (2))",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[^/\\\\][^:]*$"
        },
        "symbol": {"type": "string", "minLength": 1},
        "android_versions": {"$ref": "#/$defs/androidVersions"}
      }
    },
    "androidVersions": {
      "description": "빈 목록은 전 버전 (03-issue-db.md §5.4 (1))",
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9]+$"},
      "uniqueItems": true
    },
    "resolutionVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["unverified", "verified"]},
        "method": {"type": ["string", "null"]},
        "evidence": {
          "description": "Jira 키 또는 resolved fixture 경로(유형 디렉토리 기준)",
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "by": {"type": "string"},
        "date": {"$ref": "#/$defs/isoDate"}
      },
      "allOf": [
        {
          "$comment": "verified는 evidence 필수 (contracts.md §상태 값)",
          "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
          "then": {"required": ["evidence", "by", "date"]}
        }
      ]
    },
    "fixedIn": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["branch"],
        "properties": {"branch": {"type": "string", "minLength": 1}, "build": {"type": "string", "minLength": 1}}
      }
    },
    "fixturePath": {
      "description": "유형 디렉토리 기준 상대 경로 (contracts.md §fixture)",
      "type": "string",
      "pattern": "^fixtures/[^/]+\\.log$"
    },
    "fixVerification": {
      "description": "05-verification.md §5.12 (2) fix.verification",
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "build", "date", "by", "fixture"],
      "properties": {
        "result": {"const": "passed"},
        "build": {"type": "string", "minLength": 1},
        "date": {"$ref": "#/$defs/isoDate"},
        "by": {"type": "string", "minLength": 1},
        "jira": {"type": "string"},
        "fixture": {"$ref": "#/$defs/fixturePath"},
        "scenario_evidence": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      }
    },
    "verificationHistoryItem": {
      "description": "형식은 contracts.md §상태 값",
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "date", "by"],
      "properties": {
        "result": {"enum": ["passed", "failed", "partial", "reverted"]},
        "build": {"type": "string", "minLength": 1},
        "date": {"$ref": "#/$defs/isoDate"},
        "by": {"type": "string", "minLength": 1},
        "jira": {"type": "string"},
        "fixture": {"$ref": "#/$defs/fixturePath"},
        "ref": {"type": ["string", "null"]},
        "fixed_in": {"$ref": "#/$defs/fixedIn"},
        "note": {"type": "string"}
      }
    },
    "fix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "ref", "fixed_in", "verification", "verification_history"],
      "properties": {
        "status": {"enum": ["open", "fix-submitted", "fixed", "wont-fix", "not-a-bug"]},
        "ref": {"type": ["string", "null"]},
        "fixed_in": {"$ref": "#/$defs/fixedIn"},
        "verification": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fixVerification"}]},
        "verification_history": {"type": "array", "items": {"$ref": "#/$defs/verificationHistoryItem"}}
      },
      "allOf": [
        {
          "$comment": "fixed: ref, 빌드 있는 fixed_in 항목 1개 이상, verification(result: passed) 필수 (03-issue-db.md §5.9)",
          "if": {"properties": {"status": {"const": "fixed"}}, "required": ["status"]},
          "then": {
            "properties": {
              "ref": {"type": "string", "minLength": 1},
              "verification": {"$ref": "#/$defs/fixVerification"},
              "fixed_in": {"minItems": 1, "contains": {"required": ["branch", "build"]}}
            }
          }
        },
        {
          "$comment": "fix-submitted: ref와 fixed_in(브랜치 필수, 빌드 선택) 필수, verification 없음",
          "if": {"properties": {"status": {"const": "fix-submitted"}}, "required": ["status"]},
          "then": {
            "properties": {
              "ref": {"type": "string", "minLength": 1},
              "fixed_in": {"minItems": 1},
              "verification": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"enum": ["open", "wont-fix", "not-a-bug"]}}, "required": ["status"]},
          "then": {"properties": {"verification": {"type": "null"}}}
        }
      ]
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "title", "description", "signatures", "recovery_signatures", "scenario_signatures", "resolution", "resolution_type", "resolution_verification", "fix", "related", "android_versions", "code_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/causeId"},
        "status": {"$ref": "#/$defs/causeStatus"},
        "title": {"type": "string", "minLength": 1, "maxLength": 80},
        "description": {"type": "string", "minLength": 1},
        "signatures": {"type": "array", "items": {"$ref": "#/$defs/signature"}},
        "signatures_pending": {
          "description": "record에서 사용자가 명시할 때만. 원인에만 둔다 (contracts.md §상태 값)",
          "const": true
        },
        "recovery_signatures": {"type": "array", "items": {"$ref": "#/$defs/signature"}},
        "scenario_signatures": {"type": "array", "items": {"$ref": "#/$defs/signature"}},
        "resolution": {"type": "string", "minLength": 1},
        "resolution_type": {"enum": ["user-setting", "carrier-config", "framework-bug", "vendor-ril", "modem", "network", "hw"]},
        "resolution_verification": {"$ref": "#/$defs/resolutionVerification"},
        "fix": {"$ref": "#/$defs/fix"},
        "related": {"type": "array", "items": {"$ref": "#/$defs/causeId"}, "uniqueItems": true},
        "cp_evidence": {"type": ["string", "null"]},
        "android_versions": {"$ref": "#/$defs/androidVersions"},
        "code_refs": {"type": "array", "items": {"$ref": "#/$defs/codeRef"}}
      },
      "allOf": [
        {
          "$comment": "판별 시그니처가 비었으면 signatures_pending: true가 있어야 한다 (03-issue-db.md §5.4 (1))",
          "if": {"properties": {"signatures": {"maxItems": 0}}, "required": ["signatures"]},
          "then": {"required": ["signatures_pending"]}
        },
        {
          "$comment": "signatures_pending 원인의 해결책은 unverified 고정 (contracts.md §상태 값)",
          "if": {"required": ["signatures_pending"]},
          "then": {"properties": {"resolution_verification": {"properties": {"status": {"const": "unverified"}}}}}
        }
      ]
    }
  }
}
