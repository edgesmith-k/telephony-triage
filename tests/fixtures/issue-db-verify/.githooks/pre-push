#!/bin/sh
# telephony-triage pre-push (08-safety.md §9) — 메인테이너 소유
#
# (a) 대상 ref가 refs/heads/<base_branch>면 거부한다 (main 직접 push 금지).
# (b) 환경변수 TT_PUBLISH_TOKEN이 없으면 거부한다. 값이
#     - manual: 통과 (직접 편집 기여자가 validate 통과 후 붙인다, CONTRIBUTING.md)
#     - 그 밖: <work_dir>/<작업 키>/state.json 중 approved_hash가 토큰과 같은 것이 있어야 하고,
#       push하는 커밋의 트리가 토큰과 같고, 대상 브랜치가 그 state.json의 branch여야 한다
#       (db_pr publish가 자기 git push에만 토큰을 넣는다, contracts.md §3.2).
# 목적은 도구 경로 밖의 실수 방지이지 권한 통제가 아니다. 진짜 강제는 GHE 브랜치 보호다.
#
# 설정: ~/.telephony-triage/config.yaml (TELEPHONY_TRIAGE_HOME로 바꿀 수 있다)의
# issue_db.base_branch(기본 main)와 work_dir(기본 <home>/work). config가 없어도 기본값으로 검사한다.

command -v python3 >/dev/null 2>&1 || { echo "[telephony-triage pre-push] python3를 찾을 수 없다." >&2; exit 1; }

TT_PUSH_REFS=$(cat)
TT_HOOK_HOME="${TELEPHONY_TRIAGE_HOME:-$HOME/.telephony-triage}"
export TT_PUSH_REFS TT_HOOK_HOME

python3 - "$@" <<'EOF'
import glob, json, os, subprocess, sys

PREFIX = "[telephony-triage pre-push]"
ZERO = "0" * 40
home = os.environ["TT_HOOK_HOME"]
cfg = {}
try:
    import yaml
    with open(os.path.join(home, "config.yaml"), encoding="utf-8") as fh:
        cfg = yaml.safe_load(fh) or {}
except Exception:
    cfg = {}
base = ((cfg.get("issue_db") or {}).get("base_branch")) or "main"
work_dir = os.path.expanduser(str(cfg.get("work_dir") or os.path.join(home, "work")))
token = os.environ.get("TT_PUBLISH_TOKEN", "")


def deny(msg):
    print(f"{PREFIX} push를 거부했다: {msg}", file=sys.stderr)
    sys.exit(1)


def tree_of(sha):
    proc = subprocess.run(["git", "rev-parse", f"{sha}^{{tree}}"], capture_output=True, text=True)
    return proc.stdout.strip() if proc.returncode == 0 else None


lines = [l.split() for l in os.environ.get("TT_PUSH_REFS", "").splitlines() if l.strip()]
for parts in lines:
    if len(parts) == 4 and parts[2] == f"refs/heads/{base}":
        deny(f"base 브랜치({base})에 직접 push하지 않는다. 브랜치를 올리고 PR을 만든다.")

if not token:
    deny("TT_PUBLISH_TOKEN이 없다. 도구 흐름은 확인 화면 승인 뒤 db_pr publish가 push한다. "
         "직접 편집한 브랜치는 /telephony-triage:validate 통과 후 TT_PUBLISH_TOKEN=manual 을 붙여 push한다 "
         "(CONTRIBUTING.md).")
if token == "manual":
    sys.exit(0)

states = []
for path in glob.glob(os.path.join(work_dir, "*", "state.json")):
    try:
        with open(path, encoding="utf-8") as fh:
            state = json.load(fh)
    except Exception:
        continue
    if isinstance(state, dict) and state.get("approved_hash") == token:
        states.append(state)
if not states:
    deny("TT_PUBLISH_TOKEN이 승인된 작업(state.json의 approved_hash)과 맞지 않는다. 확인 화면을 다시 받는다.")
branches = {s.get("branch") for s in states}
for local_ref, local_sha, remote_ref, _ in (p for p in lines if len(p) == 4):
    if local_sha == ZERO:
        deny(f"승인 토큰으로 원격 ref를 지울 수 없다: {remote_ref}")
    if tree_of(local_sha) != token:
        deny(f"push하는 커밋({local_sha[:12]})의 트리가 승인 해시와 다르다 (승인 뒤 바뀌었다).")
    if not remote_ref.startswith("refs/heads/") or remote_ref[len("refs/heads/"):] not in branches:
        deny(f"대상 {remote_ref}가 승인된 작업의 브랜치({', '.join(sorted(b for b in branches if b))})가 아니다.")
sys.exit(0)
EOF
